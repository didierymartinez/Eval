# Copia este archivo como .env junto a docker-compose.yml. No lo subas al repositorio.

# --- Imagen y puerto ---
EVAL_IMAGEN=evaluaciones:latest
EVAL_PUERTO=127.0.0.1:5080

# --- Producción ---
Demo__Habilitado=false
# Nombre de esta plataforma en los archivos exportados (útil en redes aisladas).
Plataforma__Nombre=

# --- Juez IA del servidor (opcional) ---
# Cualquier API compatible con OpenAI: OpenAI, Azure OpenAI (/openai/v1/), Ollama (http://ollama:11434/v1/)...
Juez__Endpoint=
Juez__Model=
Juez__ApiKey=
# Tokens por mes que puede gastar el juez del servidor (vacío = sin límite).
Juez__LimiteTokensMes=
# false = cada equipo debe usar su propio juez (menú Jueces IA) y el servidor no paga tokens.
Juez__PermitirEnEvaluaciones=true

# --- Límites ---
# Máximo de casos por ejecución (casos × repeticiones × variantes). 0 = sin límite.
Limites__CasosPorEjecucion=0
# Casos en paralelo por corrida cuando llama la plataforma.
Corridas__MaxConcurrency=3

# --- Ejecutores remotos (vacío = API de ejecutores apagada) ---
Ejecutores__Token=

# --- Trazas OpenTelemetry (/v1/traces) ---
Trazas__Habilitado=true
# Si se define, los agentes deben mandarlo en X-Trazas-Token (los ejecutores entran con su propio token).
Trazas__Token=

# --- Claves que usan los agentes con {{env:NOMBRE}} ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Solo para el perfil "ejecutor" ---
# EVAL_PLATAFORMA=https://evaluaciones.miempresa
# EVAL_GRUPO=red-finanzas
# EVAL_EJECUTOR_TOKEN=
